# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME

# JWT signing secret — must match AUTH_SECRET in frontend/.env exactly
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Or: openssl rand -base64 48
JWT_SECRET=replace-with-same-secret-as-frontend-auth-secret

# Frontend origin for CORS (no trailing slash)
FRONTEND_ORIGIN=http://localhost:3000

# development | production
APP_ENV=development

# Stripe — required for live payments (leave blank to disable Stripe endpoints)
# Get these from https://dashboard.stripe.com/apikeys and the Webhooks section
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
