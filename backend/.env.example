# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME

# JWT signing secret — used by the backend to sign and verify session
# tokens. The frontend does NOT hold this secret (SEC-002 least-privilege
# change); Next.js middleware performs a cookie-presence check only and
# defers authoritative session validation to /api/auth/me on the backend.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Or: openssl rand -base64 48
JWT_SECRET=replace-with-a-secure-random-secret-at-least-32-chars

# Frontend origin for CORS (no trailing slash)
FRONTEND_ORIGIN=http://localhost:3000

# development | production
APP_ENV=development

# Discovery, Connection & Belonging — two pillars, two flags.
#
# DISCOVERY_PILLAR_ENABLED gates Discover Places (/api/places).
#
# WAYS_TO_CONNECT_ENABLED gates Ways to Connect
#   (GET /api/ways-to-connect). Separate on purpose: the two shipped
#   as one pillar but are not ready at the same time, and turning
#   Discover Places on must not publish Recognition as a side effect.
#
# Each has a frontend sibling — NEXT_PUBLIC_DISCOVERY_PILLAR_ENABLED
# and NEXT_PUBLIC_WAYS_TO_CONNECT_ENABLED — which are separate
# deployment controls, not mirrors. Turn the backend one on first, or
# the page renders and every API call 503s.
#
# Neither is the same thing as users.ways_to_connect_enabled, which is
# one member's own participation rather than whether the surface
# exists. Anything other than 'true' is off.
DISCOVERY_PILLAR_ENABLED=false
WAYS_TO_CONNECT_ENABLED=false

# Stripe — required for live payments (leave blank to disable Stripe endpoints)
# Get these from https://dashboard.stripe.com/apikeys and the Webhooks section
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Resend).
#
# RESEND_API_KEY — grant from https://resend.com/api-keys. When unset,
#   every email send is skipped with a WARN log; safe for local dev.
#
# EMAIL_FROM — RFC 5322 sender used on every message. When unset in a
#   configured environment (i.e. RESEND_API_KEY is set), sends fail
#   with a loud ERROR — there is no silent fallback to another domain.
#   Format: "Display Name <address@verified-domain>".
#   Example: Fresh Collective <hello@freshcollective.au>
#
# EMAIL_REPLY_TO — optional distinct Reply-To header. Leave blank to
#   have replies go back to EMAIL_FROM (the usual choice).
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
