# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME"

# JWT signing secret — generate with: node -e "require('crypto').randomBytes(48).toString('base64url') |> console.log"
# Or: openssl rand -base64 48
AUTH_SECRET="replace-with-a-secure-random-string-at-least-32-characters"

# Full public URL of the app (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Set to "production" in production environments
NODE_ENV="development"
