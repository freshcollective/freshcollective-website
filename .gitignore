# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js
.next/
out/
/frontend/build/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Backup/rotation variants written by editors and ad-hoc scripts
# (e.g. .env.bak, .env.bak.1786789292, .env.local.bak). One
# unfortunate `git add -A` would otherwise stage a full secret set.
.env.bak
.env.bak.*
.env.*.bak

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Prisma generated client (re-generated on install)
/src/generated/prisma

# Python
__pycache__/
*.py[cod]
.Python
*.egg-info/

# Virtual environments
.venv/
venv/

# Yarn
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# Uploaded files (local dev storage — replace with S3 in production)
backend/uploads/*
!backend/uploads/.gitkeep

# Runtime logs (never commit these)
logs/
*.log
