# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# URL of the FastAPI backend (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# JWT signing secret — must match JWT_SECRET in backend/.env exactly
# Generate with: node -e "require('crypto').randomBytes(48).toString('base64url') |> console.log"
# Or: openssl rand -base64 48
AUTH_SECRET=replace-with-same-secret-as-backend-jwt-secret
