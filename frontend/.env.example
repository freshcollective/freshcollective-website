# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# Public URL of the FastAPI backend — used only for media / asset URLs
# rendered by the browser (e.g. <img src="{NEXT_PUBLIC_API_URL}/api/uploads/…">).
# Application API calls do NOT use this variable — they go same-origin
# through the Next.js proxy at /api/*. See SEC-002.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side backend URL used by the Next.js proxy handler and by
# server-side helpers in src/lib/serverApi.ts. Never exposed to the
# browser and never prefixed with NEXT_PUBLIC_. On Render this is
# auto-wired to fc-api's internal URL via render.yaml.
API_INTERNAL_URL=http://localhost:8000

# Discovery, Connection & Belonging pillar. Mirrors the backend's
# DISCOVERY_PILLAR_ENABLED setting. When 'true', the pillar's nav
# entries render and its placeholder routes resolve; anything else
# (or omission) keeps the pillar hidden. Requires a rebuild + redeploy
# to take effect — Next.js inlines NEXT_PUBLIC_* at build time.
NEXT_PUBLIC_DISCOVERY_PILLAR_ENABLED=false

# Ways to Connect. Gated separately from Discover Places — the two
# shipped as one pillar but are not ready together. Same build-time
# semantics: Next.js inlines NEXT_PUBLIC_* so flipping this needs a
# rebuild, not a restart. Its backend sibling WAYS_TO_CONNECT_ENABLED
# on fc-api must be on first, or the page renders and
# GET /api/ways-to-connect 503s.
NEXT_PUBLIC_WAYS_TO_CONNECT_ENABLED=false
